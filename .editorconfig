# http://editorconfig.org
root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_style = tab
indent_size = 4
max_line_length = 120

[*.{md,yml,yaml,json,xml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
