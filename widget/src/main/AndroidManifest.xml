<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="cn.qnxg.weihuda.widget.CourseWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_course_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/course_widget_info" />
        </receiver>

        <receiver
            android:name="cn.qnxg.weihuda.widget.refresh.StatusTickReceiver"
            android:exported="false" />

        <receiver
            android:name="cn.qnxg.weihuda.widget.NetworkWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_network_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!-- 键名是系统约定：写错（android.widget.… 或重复 appwidget）会让系统拿不到
                 AppWidgetProviderInfo，卡片既不出现在长按列表，也无法应用内添加 -->
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/network_widget_info" />
        </receiver>

        <receiver
            android:name="cn.qnxg.weihuda.widget.CountdownWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_countdown_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <receiver
            android:name="cn.qnxg.weihuda.widget.refresh.CountdownTickReceiver"
            android:exported="false" />

        <receiver
            android:name="cn.qnxg.weihuda.widget.CampusCardWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_card_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/campus_card_widget_info" />
        </receiver>

        <receiver
            android:name="cn.qnxg.weihuda.widget.ElectricityWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_electricity_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/electricity_widget_info" />
        </receiver>

        <receiver
            android:name="cn.qnxg.weihuda.widget.PinResultReceiver"
            android:exported="false" />
    </application>

</manifest>
